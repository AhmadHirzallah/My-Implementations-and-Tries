{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug my_program",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/my_program",
			"pf_s->ap": [],
			"stopAtEntry": false,
			"cwd": "${workspaceFolder}",
			"environment": [],
			"externalConsole": false,
			"MIMode": "gdb",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				}
			],
			"preLaunchTask": "Build main.c",
			"miDebuggerPath": "/usr/bin/gdb",
			"logging": {
				"trace": true,
				"traceResponse": true,
				"engineLogging": false,
				"programOutput": true,
				"exceptions": true
			},
			"internalConsoleOptions": "openOnSessionStart",
		}
	]
}